rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Tylko klient zalogowany (anonimowo przez apkę) może czytać i pisać.
    // To NIE jest pełna kontrola uprawnień per-pracownik (do tego potrzebna byłaby
    // Cloud Function z custom claims) - to jest bariera przeciw przypadkowym/botowym
    // zapisom z internetu na otwarty adres apki.
    function isSignedIn() {
      return request.auth != null;
    }

    match /forklifts/{forkliftId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasAll(['vin', 'model', 'stage'])
                    && request.resource.data.vin is string
                    && request.resource.data.stage is string;
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    match /meta/settings {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
